{
	"name": "@thinkrail/monorepo",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@astrojs/check": "0.9.10",
			"@earendil-works/pi-agent-core": "0.84.3",
			"@earendil-works/pi-ai": "0.84.3",
			"@earendil-works/pi-coding-agent": "0.84.3",
			"@fontsource-variable/geist": "5.3.0",
			"@fontsource-variable/jetbrains-mono": "5.3.0",
			"@fontsource-variable/orbitron": "5.3.0",
			"@tailwindcss/vite": "4.3.1",
			"@types/bun": "1.3.14",
			"@types/react": "19.2.17",
			"@types/react-dom": "19.2.3",
			"astro": "7.2.4",
			"lucide-react": "1.21.0",
			"react": "19.3.0-canary-a1124489-20260826",
			"react-dom": "19.3.0-canary-a1124489-20260826",
			"tailwindcss": "4.3.1",
			"typebox": "1.3.7",
			"typescript": "6.0.3"
		}
	},
	"overrides": {
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "bun scripts/dev.ts",
		"dev:server": "turbo run dev --filter=@thinkrail/server",
		"dev:web": "turbo run dev --filter=@thinkrail/web",
		"build:web": "turbo run build --filter=@thinkrail/web",
		"build:binary": "bun run build:web && bun apps/cli/scripts/build-binary.ts",
		"smoke:binary": "bun apps/cli/scripts/smoke-binary.ts",
		"desktop:build": "bun run build:web && bun apps/desktop/build.ts --env=dev",
		"desktop:dev": "bun run build:web && bun apps/desktop/build.ts --env=dev --run",
		"desktop:package:canary": "bun run build:web && bun apps/desktop/build.ts --env=canary",
		"desktop:package:stable": "bun run build:web && bun apps/desktop/build.ts --env=stable",
		"smoke:desktop": "bun apps/desktop/smoke.ts",
		"smoke:desktop:installer": "bun apps/desktop/installerSmoke.ts",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepare": "husky",
		"e2e": "bun e2e/run.ts",
		"e2e:serial": "bun e2e/run.ts --serial",
		"e2e:binary": "playwright test -c playwright.binary.config.ts",
		"e2e:desktop": "bun e2e/run-desktop.ts",
		"test:workflows": "playwright test -c playwright.workflows.config.ts",
		"e2e:full": "playwright test",
		"e2e:full:headed": "playwright test --headed",
		"e2e:agent": "playwright test --grep @agent",
		"e2e:agent:headed": "playwright test --grep @agent --headed",
		"e2e:headed": "playwright test --headed",
		"e2e:ui": "playwright test --ui",
		"check:deps": "bun scripts/check-catalog.ts",
		"check:boundaries": "bun test scripts/checkModuleBoundaries.test.ts && bun scripts/check-module-boundaries.ts",
		"check:seams": "bun scripts/check-binary-seams.ts",
		"typography:generate": "bun --filter @thinkrail/web typography:generate",
		"typography:validate": "bun --filter @thinkrail/web typography:validate",
		"typography:check": "bun --filter @thinkrail/web typography:check",
		"colors:generate": "bun --filter @thinkrail/web colors:generate",
		"colors:check": "bun --filter @thinkrail/web colors:check",
		"spacing:generate": "bun --filter @thinkrail/web spacing:generate",
		"spacing:check": "bun --filter @thinkrail/web spacing:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@thinkrail/contracts": "workspace:*",
		"@thinkrail/desktop": "workspace:*",
		"@thinkrail/server": "workspace:*",
		"@thinkrail/shared": "workspace:*",
		"@playwright/test": "1.61.0",
		"husky": "9.1.7",
		"pi-todos": "workspace:*",
		"turbo": "2.9.18",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	]
}
