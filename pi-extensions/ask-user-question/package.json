{
	"name": "@thinkrail/pi-ask-user-question",
	"version": "0.0.0",
	"description": "A pi extension adding an `ask_user_question` tool: the agent asks structured multiple-choice questions instead of guessing, answered in a terminal questionnaire, in an RPC host's dialogs, or in a host's own UI.",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"ask-user-question",
		"questionnaire"
	],
	"homepage": "https://thinkrail.ai",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JetBrains/thinkrail.git",
		"directory": "pi-extensions/ask-user-question"
	},
	"bugs": "https://github.com/JetBrains/thinkrail/issues",
	"author": "ThinkRail",
	"files": [
		"index.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./index.ts",
		"./index.ts": "./index.ts",
		"./core": "./src/core.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-tui": "catalog:",
		"@types/bun": "catalog:",
		"typebox": "catalog:",
		"typescript": "catalog:"
	}
}
