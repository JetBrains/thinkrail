---
import BaseHead from "../components/BaseHead.astro";
import IdeShell from "../components/IdeShell.astro";

export interface ShellFile {
	href: string;
	label: string;
}

interface Props {
	title: string;
	description?: string | undefined;
	article?: { publishedTime: Date } | undefined;
	workspace: string;
	nav: "blog" | "docs";
	files: readonly ShellFile[];
}

const { title, description, article, workspace, nav, files } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const normalizePath = (path: string) => path.replace(/\/+$/, "");
const isCurrent = (path: string) => normalizePath(Astro.url.pathname) === normalizePath(path);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og.png", Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
		<slot name="head" />
	</head>
	<body>
		<IdeShell workspace={workspace} nav={nav} skipHref="#page-content">
			<main class="editor" id="editor-scroll" aria-label="Page content">
				<div class="page-main" id="page-content">
					<slot />
				</div>
			</main>

			<Fragment slot="filetree">
				{
					files.map((file) => (
						<a
							class:list={["ft-row", "file", { active: isCurrent(file.href) }]}
							href={file.href}
							aria-current={isCurrent(file.href) ? "page" : undefined}
						>
							<svg class="i" aria-hidden="true">
								<use href="#i-file-text" />
							</svg>
							{file.label}
						</a>
					))
				}
			</Fragment>
		</IdeShell>
	</body>
</html>
