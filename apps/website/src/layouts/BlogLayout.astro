---
import { postPath, publishedPosts } from "../blogCollection";
import ShellLayout from "./ShellLayout.astro";

interface Props {
	title: string;
	description?: string | undefined;
	article?: { publishedTime: Date } | undefined;
}

const { title, description, article } = Astro.props;
const files = (await publishedPosts()).map((post) => ({
	href: postPath(post),
	label: post.data.title,
}));
---

<ShellLayout
	title={title}
	description={description}
	article={article}
	workspace="blog"
	nav="blog"
	files={files}
>
	<link slot="head" rel="alternate" type="application/rss+xml" title="ThinkRail Blog" href="/blog/rss.xml" />
	<slot />
</ShellLayout>
