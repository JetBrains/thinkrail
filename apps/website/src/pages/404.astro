<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="theme-color" content="#09090b" />
		<title>Page not found | ThinkRail</title>
		<style>
			:root {
				color-scheme: dark;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #dfe1e5;
				background: #09090b;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
			}

			* {
				box-sizing: border-box;
			}

			body {
				min-height: 100vh;
				margin: 0;
				display: grid;
				place-items: center;
				padding: 1.5rem;
			}

			main {
				width: min(100%, 38rem);
				padding: clamp(1.5rem, 5vw, 3rem);
				border: 1px solid #2b2d30;
				border-radius: 0.75rem;
				background: #18181b;
				box-shadow: 0 24px 80px rgb(0 0 0 / 0.4);
			}

			p {
				margin: 0;
				color: #a8adb5;
				font-size: 1rem;
				line-height: 1.7;
			}

			.eyebrow {
				margin-bottom: 0.75rem;
				color: #8dff4f;
				font-size: 0.8125rem;
				font-weight: 650;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				font-size: clamp(1.75rem, 6vw, 2.5rem);
				line-height: 1.15;
				letter-spacing: -0.035em;
			}

			.message {
				margin-top: 1rem;
			}

			a {
				display: inline-flex;
				min-height: 2.75rem;
				align-items: center;
				margin-top: 2rem;
				padding: 0.7rem 1rem;
				border: 1px solid #8dff4f;
				border-radius: 0.4rem;
				background: #8dff4f;
				color: #0a0a0a;
				font-weight: 650;
				text-decoration: none;
			}

			a:hover {
				border-color: #59d915;
				background: #59d915;
			}

			a:focus-visible {
				outline: 3px solid #8dff4f;
				outline-offset: 3px;
			}
		</style>
	</head>
	<body>
		<main aria-labelledby="not-found-title">
			<p class="eyebrow">ThinkRail</p>
			<h1 id="not-found-title">Page not found</h1>
			<p class="message">The page you’re looking for doesn’t exist or may have moved.</p>
			<a href="/">Return to the home page</a>
		</main>
	</body>
</html>
