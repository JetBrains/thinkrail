---
import { desktopInstallerPlatforms, installCommands, windowsShellLabels } from "../installCommands";

interface Props {
	idPrefix: "hero" | "blog";
}

const { idPrefix } = Astro.props;
---

<div class:list={["install-picker", `install-picker-${idPrefix}`]} data-install-picker={idPrefix}>
	<div class="install-frame">
		<div class="install-tabs">
			<div class="install-os-tabs" role="tablist" aria-label="Choose your operating system">
				{desktopInstallerPlatforms.map(({ id, label }) => (
					<button
						type="button"
						class="install-tab"
						role="tab"
						id={`${idPrefix}-install-${id}-tab`}
						aria-controls={`${idPrefix}-install-${id}`}
						aria-selected={id === "linux" ? "true" : "false"}
						tabindex={id === "linux" ? undefined : "-1"}
						data-install-platform={id}
					>
						{label}
					</button>
				))}
			</div>
		</div>
		{desktopInstallerPlatforms.map(({ id, label, detail, downloads }) => (
			<div
				class="install-panel"
				id={`${idPrefix}-install-${id}`}
				role="tabpanel"
				aria-labelledby={`${idPrefix}-install-${id}-tab`}
				data-install-panel={id}
			>
				<p class="install-fallback-heading">{label}</p>
				<div class="desktop-install">
					<span class="desktop-install-detail">{detail}</span>
					<div class="desktop-install-actions">
						{downloads.map((download) => (
							<a class="btn btn-primary desktop-download-link" href={download.href} aria-label={`${download.label} for ${label}: ${detail}`}>
								{download.label} ↓
							</a>
						))}
					</div>
				</div>
				<details class="cli-disclosure">
					<summary>Browser UI via command line</summary>
					<div class="cli-disclosure-body">
						<p class="browser-ui-note">Install the local launcher; run <code>thinkrail</code> to open the browser UI.</p>
						{id === "windows" && (
							<div class="windows-shell-tabs" role="tablist" aria-label="Choose your Windows shell">
								<button type="button" class="windows-shell-tab" role="tab" id={`${idPrefix}-shell-powershell-tab`} aria-controls={`${idPrefix}-shell-powershell`} aria-selected="true" data-windows-shell="powershell">{windowsShellLabels.powershell}</button>
								<button type="button" class="windows-shell-tab" role="tab" id={`${idPrefix}-shell-cmd-tab`} aria-controls={`${idPrefix}-shell-cmd`} aria-selected="false" tabindex="-1" data-windows-shell="cmd">{windowsShellLabels.cmd}</button>
								<button type="button" class="windows-shell-tab" role="tab" id={`${idPrefix}-shell-wsl-tab`} aria-controls={`${idPrefix}-shell-wsl`} aria-selected="false" tabindex="-1" data-windows-shell="wsl">{windowsShellLabels.wsl}</button>
							</div>
						)}
					{id === "windows" ? (
						<div class="windows-shell-picker">
							<div class="windows-shell-panel" id={`${idPrefix}-shell-powershell`} role="tabpanel" aria-labelledby={`${idPrefix}-shell-powershell-tab`} data-windows-shell-panel="powershell">
								<p class="install-fallback-heading">{windowsShellLabels.powershell}</p>
								<div class="install-line">
									<code data-install-command tabindex="0">{installCommands.windows.powershell}</code>
									<button type="button" class="copy-btn" data-copy={installCommands.windows.powershell} aria-label="Copy PowerShell install command">
										<svg class="i" aria-hidden="true"><use href="#i-copy" /></svg>
										<svg class="i i-done" aria-hidden="true"><use href="#i-check" /></svg>
									</button>
								</div>
							</div>
							<div class="windows-shell-panel" id={`${idPrefix}-shell-cmd`} role="tabpanel" aria-labelledby={`${idPrefix}-shell-cmd-tab`} data-windows-shell-panel="cmd">
								<p class="install-fallback-heading">{windowsShellLabels.cmd}</p>
								<div class="install-line">
									<code data-install-command tabindex="0">{installCommands.windows.cmd}</code>
									<button type="button" class="copy-btn" data-copy={installCommands.windows.cmd} aria-label="Copy Command Prompt (cmd) install command">
										<svg class="i" aria-hidden="true"><use href="#i-copy" /></svg>
										<svg class="i i-done" aria-hidden="true"><use href="#i-check" /></svg>
									</button>
								</div>
							</div>
							<div class="windows-shell-panel" id={`${idPrefix}-shell-wsl`} role="tabpanel" aria-labelledby={`${idPrefix}-shell-wsl-tab`} data-windows-shell-panel="wsl">
								<p class="install-fallback-heading">{windowsShellLabels.wsl}</p>
								<div class="install-line">
									<code data-install-command tabindex="0">{installCommands.windows.wsl}</code>
									<button type="button" class="copy-btn" data-copy={installCommands.windows.wsl} aria-label="Copy WSL install command">
										<svg class="i" aria-hidden="true"><use href="#i-copy" /></svg>
										<svg class="i i-done" aria-hidden="true"><use href="#i-check" /></svg>
									</button>
								</div>
							</div>
						</div>
					) : (
						<div class="install-line">
							<code data-install-command tabindex="0">{installCommands[id]}</code>
							<button type="button" class="copy-btn" data-copy={installCommands[id]} aria-label={`Copy ${label} CLI install command`}>
								<svg class="i" aria-hidden="true"><use href="#i-copy" /></svg>
								<svg class="i i-done" aria-hidden="true"><use href="#i-check" /></svg>
							</button>
						</div>
						)}
					</div>
				</details>
			</div>
		))}
	</div>
</div>
