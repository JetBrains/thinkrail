---
// The invariant head plumbing every page shares. Page-specific metadata (title, description,
// canonical, OG) stays in the page or layout that owns it — this component carries only what must
// never diverge between pages: charset/viewport, the favicon, the global stylesheet (which bundles
// the self-hosted fonts), the pre-paint theme guard, and the analytics loaders.
import "../styles.css";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#171719" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- Pre-paint theme guard: the inline twin of src/theme.ts (it cannot import modules). Saved
     explicit choice wins (legacy darcula/gruvbox values normalize to dark), else OS preference. -->
<script is:inline>
	try {
		const saved = localStorage.getItem("thinkrail-site-theme");
		const theme =
			saved === "light"
				? "light"
				: saved
					? "dark"
					: window.matchMedia("(prefers-color-scheme: light)").matches
						? "light"
						: "dark";
		document.documentElement.setAttribute("data-theme", theme);
	} catch {
		/* storage unavailable — keep the server-rendered default */
	}
</script>
<script>
	// Production-only, cookieless PostHog + GTM (both self-gate on hostname). The config lives ONLY
	// in src/analytics.ts / src/gtm.ts — unit-tested there, loaded identically on every page.
	import { initAnalytics } from "../analytics";
	import { initGtm } from "../gtm";

	initAnalytics();
	initGtm();
</script>
