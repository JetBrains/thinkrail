</svg>

<a class="skip-link" href={skipHref}>Skip to content</a>

<div class="window">
	<!-- ══ Title bar ══ -->
	<header class="titlebar">
		<span class="wordmark-logo" aria-hidden="true"><svg viewBox="0 0 556.36 449.2" fill="currentColor" aria-hidden="true"><path d="m 460.1 294.06 l -2.04 -3.26 c 7.4 -6.37 13.71 -13.31 18.99 -20.72 c 15.49 -21.7 22.25 -47.43 22.13 -74.72 l -0.07 -15.38 c 0.64 -6.21 0.89 -9.98 0.89 -9.98 l -0.02 -71.65 c -0.02 -54.32 -44.07 -98.35 -98.39 -98.35 h -61.59 v 31.11 c 0 4.91 3.98 8.89 8.89 8.89 l 50.02 0.78 c 34.18 0.39 61.81 27.98 62.22 62.17 l 1.07 88.19 c 0.43 28.75 -0.16 67.01 -62.89 86.49 l 104.13 171.57 h 52.92 l -55.98 -90.56 Z m -85.96 -44.06 c 30.95 0 56.02 -25.11 55.98 -56.05 l -0.12 -82.65 c 0 -22.81 -18.49 -41.3 -41.3 -41.3 h -208.7 v 31.775 c 0 4.543 3.682 8.225 8.225 8.225 h 186.645 c 8.356 0 15.13 6.774 15.13 15.13 v 63.87 c 0 9.542 -7.808 17.35 -17.35 17.35 h -60.79 c -57.12 0 -81.27 15.75 -88.22 21.54 c -0.9 0.76 -2.28 0.12 -2.29 -1.07 l -0.921 -79.961 c -0.044 -3.801 -3.138 -6.859 -6.938 -6.859 h -33.491 v 309.2 h 40 v -127.96 c 0 -43.97 24.37 -71.24 79.74 -71.24 Z m -233.57 -180 h -140.57 v 40 h 110 v 339.2 h 40 v -369.77 c 0 -5.21 -4.22 -9.43 -9.43 -9.43 Z m 169.43 -38.12 v -31.88 h -310 v 40 h 301.88 c 4.49 0 8.12 -3.64 8.12 -8.12 Z m 41.9 248.12 h -63.24 c -21.87 0 -39.61 17.74 -39.61 39.61 v 129.59 h 40.06 l 0.62 -108.59 c 0.06 -11.4 9.32 -20.61 20.72 -20.61 h 23.39 c 3.84 0 7.42 1.95 9.5 5.18 l 79.72 124.02 h 45.34 l -96.56 -158.01 c -4.25 -6.95 -11.8 -11.19 -19.94 -11.19 Z" /></svg></span>
		<div class="scope">
			<span class="scope-crumbs">
				<span class="scope-project">thinkrail</span>
				<svg class="i" aria-hidden="true"><use href="#i-chevron-right" /></svg>
				<span class="scope-name">{workspace}</span>
			</span>
			<span class="scope-branch">
				<svg class="i" aria-hidden="true"><use href="#i-branch" /></svg>
				workspace/{workspace} · from main
			</span>
		</div>
		<div class="titlebar-right">
			<a
				class="chrome-btn gh-btn"
				href="https://github.com/JetBrains/thinkrail"
				aria-label="ThinkRail on GitHub"
			>
				<svg class="i i-fill" aria-hidden="true"><use href="#i-github" /></svg>
				<span class="gh-stars" id="gh-stars" hidden></span>
			</a>
			<button
				type="button"
				class="theme-toggle"
				id="theme-toggle"
				aria-label="Switch to light theme"
			>
				<svg class="i theme-icon-sun" aria-hidden="true"><use href="#i-sun" /></svg>
				<svg class="i theme-icon-moon" aria-hidden="true"><use href="#i-moon" /></svg>
			</button>
			<button type="button" class="chrome-btn nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="rail-right" aria-label="Open file tree">
				<svg class="i" aria-hidden="true"><use href="#i-menu" /></svg>
			</button>
		</div>
	</header>

	<div class="cols">
		<!-- ══ Left rail: projects ══ -->
		<aside class="rail-left" aria-label="Projects">
			<div class="rail-left-nav">
				<div class="rail-heading">Projects <svg class="i" aria-hidden="true"><use href="#i-plus" /></svg></div>
				<div class="tree">
					<div class="tree-row active">
						<svg class="i" aria-hidden="true"><use href="#i-chevron-down" /></svg>
						<svg class="i" aria-hidden="true"><use href="#i-folder" /></svg>
						<span>thinkrail</span>
					</div>
					<div class="tree-row workspace active">
						<svg class="i" aria-hidden="true"><use href="#i-branch" /></svg>
						<span>website</span>
					</div>
					<a
						class:list={["tree-row", "page", { selected: nav === "landing" }]}
						href="/"
						aria-current={nav === "landing" ? "page" : undefined}
					>
						<svg class="i" aria-hidden="true"><use href="#i-file" /></svg>
						<span>Landing</span>
					</a>
					<a
						class:list={["tree-row", "page", { selected: nav === "blog" }]}
						href="/blog/"
						aria-current={nav === "blog" ? "page" : undefined}
					>
						<svg class="i" aria-hidden="true"><use href="#i-file-text" /></svg>
						<span>Blog</span>
					</a>
					<div class="tree-row page disabled">
						<svg class="i" aria-hidden="true"><use href="#i-book" /></svg>
						<span>Docs</span>
						<b class="tree-tag">Coming soon</b>
					</div>
				</div>
			</div>
			<div class="rail-note" id="rail-note">
				<svg class="rail-note-icon" aria-hidden="true"><use href="#i-info" /></svg>
				<p>A workspace is a <code>git worktree</code>: its own branch, files, terminals, and chats.</p>
				<button type="button" class="rail-note-dismiss" id="rail-note-dismiss">Understood</button>
			</div>
			<script>
				(() => {
					const note = document.getElementById("rail-note");
					if (!note) return;
					note.classList.add("pending");
					window.setTimeout(() => {
						note.classList.remove("pending");
					}, 10000);
				})();
			</script>
		</aside>

		<!-- ══ Center column: the page's content (landing: tab strip + editor; blog: editor) ══ -->
		<div class="center">
			<slot />
		</div>

		<!-- ══ Right rail: file tree + terminal ══ -->
		<aside class="rail-right" id="rail-right" aria-label="Files and terminal">
			<div class="rail-tabs" data-mock-hint="Want the real thing?" data-mock-label="Files and terminal tabs — a static mock">
				<span class="rail-tab dim" title="In the app: the worktree's spec graph">Specs</span>
				<span class="rail-tab active">All files</span>
				<span class="rail-tab dim" title="In the app: the live git diff">Changes</span>
				<span class="rail-tab dim" title="In the app: run hooks">Hooks</span>
			</div>
			<nav class="filetree" aria-label="Files">
				<slot name="filetree" />
			</nav>
			<div class="terminal">
				<div class="terminal-head">
					<span class="terminal-label">Terminal</span>
					<button type="button" class="term-replay" data-term-replay hidden>Replay logo</button>
				</div>
				<pre class="term-screen" id="term-screen"><span class="term-line"><span class="term-prompt">❯</span> curl -fsSL https://raw.githubusercontent.com/JetBrains/thinkrail/main/install.sh | bash</span><span class="term-out">⬇ thinkrail latest (macos-arm64) · sha256 verified ✓
✓ installed — starting ThinkRail …</span></pre>
			</div>
		</aside>
		<div class="rail-backdrop" id="rail-backdrop" hidden></div>
	</div>

	<!-- ══ Status bar ══ -->
	<footer class="statusbar">
		<span class="sb-item"><Copyright /></span>
	</footer>
</div>

<script>
	import "../main";
</script>
