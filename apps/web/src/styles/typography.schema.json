{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://thinkrail.ai/schemas/typography.schema.json",
	"title": "ThinkRail typography source",
	"description": "The canonical, machine-first typography definition: primitives plus the semantic text styles generated from them. Contains no CSS selectors, class strings, component paths, usage inventories or rationale — those live in TYPOGRAPHY.md and in the generator.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"metadata",
		"fontFamilies",
		"fontWeights",
		"fontSizes",
		"lineHeights",
		"letterSpacings",
		"textStyles",
		"proseStyles"
	],
	"properties": {
		"$schema": { "type": "string" },
		"metadata": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version", "cssVarPrefix", "classPrefix"],
			"properties": {
				"version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
				"cssVarPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
				"classPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
			}
		},
		"fontFamilies": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["stack", "kind"],
				"properties": {
					"stack": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string", "minLength": 1 }
					},
					"kind": { "enum": ["proportional", "monospace"] }
				}
			}
		},
		"fontWeights": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": { "type": "integer", "minimum": 100, "maximum": 900 }
		},
		"fontSizes": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
		},
		"lineHeights": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
		},
		"letterSpacings": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": { "type": "string", "minLength": 1 }
		},
		"textStyles": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/groupId" },
			"additionalProperties": {
				"type": "object",
				"minProperties": 1,
				"propertyNames": { "$ref": "#/definitions/tokenId" },
				"additionalProperties": { "$ref": "#/definitions/style" }
			}
		},
		"proseStyles": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/definitions/tokenId" },
			"additionalProperties": { "$ref": "#/definitions/style" }
		}
	},
	"definitions": {
		"tokenId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
		"groupId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
		"style": {
			"description": "A semantic text style. Every property is a reference to a primitive token id; a style resolves deterministically with no inheritance, per-usage branching or fallback.",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"fontFamily",
				"fontSize",
				"fontWeight",
				"lineHeight",
				"letterSpacing",
				"textTransform",
				"fontStyle"
			],
			"properties": {
				"fontFamily": { "$ref": "#/definitions/tokenId" },
				"fontSize": { "$ref": "#/definitions/tokenId" },
				"fontWeight": { "$ref": "#/definitions/tokenId" },
				"lineHeight": { "$ref": "#/definitions/tokenId" },
				"letterSpacing": { "$ref": "#/definitions/tokenId" },
				"textTransform": { "enum": ["none", "uppercase", "lowercase", "capitalize"] },
				"fontStyle": { "enum": ["normal", "italic"] }
			}
		}
	}
}
