				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI",
				"sans-serif"
			],
			"kind": "proportional"
		},
		"code": {
			"stack": [
				"JetBrains Mono Variable",
				"JetBrains Mono",
				"Fira Code",
				"SF Mono",
				"Cascadia Code",
				"monospace"
			],
