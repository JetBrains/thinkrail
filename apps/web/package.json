{
	"name": "@thinkrail/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "bun run typography:check && bun run colors:check && bun run spacing:check && bun run provider-glyphs:check && bun run i18n:check && tsc --noEmit && vite build",
		"build:profile": "vite build --mode profile",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"preview": "vite preview",
		"i18n:coverage": "bun scripts/i18n-coverage.ts",
		"i18n:keys": "bun scripts/i18n-keys.ts --write",
		"i18n:keys:check": "bun scripts/i18n-keys.ts",
		"i18n:codemod": "bun scripts/i18n-codemod.ts",
		"i18n:check": "bun scripts/i18n-keys.ts && bun scripts/i18n-coverage.ts --check --min 100",
		"typography:generate": "bun scripts/generate-typography.ts",
		"typography:validate": "bun scripts/validate-typography.ts",
		"typography:check": "bun scripts/generate-typography.ts --check && bun test src/styles/typographyUsage.test.ts",
		"colors:generate": "bun scripts/generate-colors.ts",
		"colors:check": "bun scripts/generate-colors.ts --check && bun test src/styles/colorUsage.test.ts",
		"spacing:generate": "bun scripts/generate-spacing.ts",
		"spacing:check": "bun scripts/generate-spacing.ts --check && bun test src/styles/spacingUsage.test.ts",
		"provider-glyphs:generate": "bun scripts/generate-provider-glyphs.ts",
		"provider-glyphs:check": "bun scripts/generate-provider-glyphs.ts --check",
		"compiler:census": "bun scripts/compiler-census.ts",
		"compiler:census:generate": "bun scripts/compiler-census.ts --write",
		"compiler:census:check": "bun scripts/compiler-census.ts --check"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@fontsource-variable/geist": "catalog:",
		"@fontsource-variable/jetbrains-mono": "catalog:",
		"@fontsource-variable/noto-sans-sc": "catalog:",
		"@fontsource-variable/orbitron": "catalog:",
		"@remixicon/react": "catalog:",
		"@shikijs/langs": "4.2.0",
		"@thinkrail/contracts": "workspace:*",
		"@thinkrail/ext-visualize": "workspace:*",
		"@thinkrail/extension-api": "workspace:*",
		"@thinkrail/resource-renderers": "workspace:*",
		"@thinkrail/ui": "workspace:*",
		"@xterm/addon-clipboard": "0.2.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-fonts": "0.1.0",
		"@xterm/xterm": "6.0.0",
		"marked": "16.4.2",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "catalog:",
		"react-virtuoso": "catalog:",
		"remark-gfm": "catalog:",
		"shiki": "catalog:",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@lobehub/icons-static-svg": "1.95.1",
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "catalog:",
		"@types/babel__core": "7.20.5",
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "6.0.2",
		"babel-plugin-react-compiler": "1.0.0",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "8.0.16"
	}
}
