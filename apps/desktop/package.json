{
	"name": "@thinkrail/desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"package:dev": "electrobun build --env=dev",
		"dev": "electrobun dev",
		"package:canary": "electrobun build --env=canary",
		"package:stable": "electrobun build --env=stable",
		"tauri": "tauri",
		"dev:tauri": "tauri dev",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"tauri:build": "tauri build",
		"typecheck": "electrobun prepare && tsc --noEmit",
		"typecheck:tauri": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@thinkrail/contracts": "workspace:*",
		"@thinkrail/locales": "workspace:*",
		"@thinkrail/server": "workspace:*",
		"@thinkrail/shared": "workspace:*"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.5",
		"@types/bun": "catalog:",
		"electrobun": "2.0.5",
		"resedit": "catalog:",
		"typescript": "catalog:"
	}
}
