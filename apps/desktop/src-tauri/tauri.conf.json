{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThinkRail",
  "version": "0.0.0-dev",
  "identifier": "ai.thinkrail.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ThinkRail",
        "width": 1440,
        "height": 920
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' ipc: http://ipc.localhost data: blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [],
    "externalBin": ["binaries/thinkrail-sidecar"],
    "macOS": {
      "entitlements": "./entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["thinkrail"]
      }
    }
  }
}
