# Domain the relay answers on (Caddy obtains its TLS certificate automatically).
RELAY_DOMAIN=relay.example.com
# Domain (or IP) clients reach coturn at; can be the same host as the relay.
TURN_DOMAIN=turn.example.com
# This server's public IPv4 address, announced by coturn.
PUBLIC_IP=203.0.113.10
# Shared secret between the relay and coturn: generate with `openssl rand -hex 32`, never commit it.
TURN_SECRET=
# The relay image the relay-image workflow publishes, pinned to a version.
RELAY_IMAGE=ghcr.io/<owner>/thinkrail-relay:0.1.0
