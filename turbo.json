{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["THINKRAIL_*", "PI_CODING_AGENT_DIR"],
	"globalDependencies": ["patches/**", "tsconfig.base.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["THINKRAIL_SOURCEMAPS_RELEASE"],
			"passThroughEnv": ["POSTHOG_CLI_API_KEY", "POSTHOG_CLI_PROJECT_ID", "POSTHOG_CLI_HOST"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"//#typecheck:root": {
			"outputs": [],
			"cache": false
		},
		"test": {
			"dependsOn": ["transit"],
			"outputs": []
		},
		"clean": {
			"cache": false
		}
	}
}
