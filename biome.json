{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!designs",
			"!design-audit/buttons.html",
			"!**/.claude",
			"!packages/design-tokens/styles/generated",
			"!packages/chat-ui/src/generated"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noImpliedEval": "error",
				"noFloatingPromises": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useThrowOnlyError": "error",
				"useThrowNewError": "error",
				"noEnum": "error",
				"noNamespace": "error",
				"noParameterProperties": "error",
				"useReadonlyClassProperties": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noNestedPromises": "error",
				"noUnusedExpressions": "error",
				"useGuardForIn": "error",
				"noEvolvingTypes": "error",
				"noIdenticalTestTitle": "error"
			},
			"correctness": {
				"noPlaywrightMissingAwait": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/**", "!apps/web/src/lib/nullProto.ts"],
			"plugins": ["./biome-plugins/nullProto.grit"]
		},
		{
			"includes": [
				"apps/web/**",
				"apps/website/**",
				"packages/resource-renderers/**",
				"packages/ui/**",
				"thinkrail-extensions/*/web/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useHookAtTopLevel": "error"
					}
				}
			}
		}
	]
}
